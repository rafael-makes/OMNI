<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_zones</name>
  <version>0.1.0</version>
  <description>OMNI named zones (rooms) as map-frame polygons — a ROS-free shared library used by behavior_node and world_state</description>
  <maintainer email="pi@omni.local">pi</maintainer>
  <license>MIT</license>

  <!-- Deliberately no rclpy dependency: this package is pure Python and must
       import on a desktop with no ROS installed. -->
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
