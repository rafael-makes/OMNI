# OMNI external dependencies — vcstool manifest
#
# These packages live in src/ but are NOT tracked in this repo (see .gitignore).
# They are upstream sources built from scratch because Debian Trixie has no ROS2
# apt packages. This file pins what each was built from, so a fresh clone can
# reproduce the workspace:
#
#   cd ~/omni_ws
#   vcs import src < omni.repos
#   patch -d src/slam_toolbox -p1 < patches/slam_toolbox-headless.patch
#   colcon build --symlink-install
#
# !! slam_toolbox carries a local patch. See patches/slam_toolbox-headless.patch
#    and the note at the bottom of this file — importing without applying it
#    fails the build on a headless Pi.
#
# Pinned 2026-07-19 from the working tree. Tags where upstream provides one;
# commit shas where the local checkout tracks a branch.

repositories:

  # ── Navigation & SLAM ──────────────────────────────────────────────────────
  navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: 1.3.12

  slam_toolbox:
    type: git
    url: https://github.com/SteveMacenski/slam_toolbox.git
    version: 2.8.5          # PATCHED — see note below

  bond_core:
    type: git
    url: https://github.com/ros/bond_core.git
    version: 4.2.0          # slam_toolbox lifecycle dependency

  BehaviorTree.CPP:
    type: git
    url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
    version: 4.9.0

  # ── Messages & interfaces ──────────────────────────────────────────────────
  vision_msgs:
    type: git
    url: https://github.com/ros-perception/vision_msgs.git
    version: 1adca4d        # branch 'ros2' — no tag on the built commit

  apriltag_msgs:
    type: git
    url: https://github.com/christianrauch/apriltag_msgs.git
    version: 2.0.2

  geographic_info:
    type: git
    url: https://github.com/ros-geographic-info/geographic_info.git
    version: 1.0.7

  # ── Support libraries ──────────────────────────────────────────────────────
  angles:
    type: git
    url: https://github.com/ros/angles.git
    version: 1.16.1

  laser_geometry:
    type: git
    url: https://github.com/ros-perception/laser_geometry.git
    version: 2.7.2

  interactive_markers:
    type: git
    url: https://github.com/ros-visualization/interactive_markers.git
    version: 2.5.5

  diagnostics:
    type: git
    url: https://github.com/ros/diagnostics.git
    version: d4b2aa0        # branch 'ros2' — no tag on the built commit

  # ── Tooling ────────────────────────────────────────────────────────────────
  ros-foxglove-bridge:
    type: git
    url: https://github.com/foxglove/ros-foxglove-bridge.git
    version: 0.7.9          # launched by omni_full_launch.py as foxglove_node

  teleop_twist_keyboard:
    type: git
    url: https://github.com/ros2/teleop_twist_keyboard.git
    version: dashing        # UNVERIFIED — the local copy has no .git, so the
                            # built version could not be read back. Confirm
                            # before trusting this pin.

# ── Local modifications ──────────────────────────────────────────────────────
#
# slam_toolbox (patches/slam_toolbox-headless.patch)
#   Makes the RViz2 plugin optional behind BUILD_RVIZ_PLUGIN (default OFF) and
#   drops the hard Qt5 / rviz_* / interactive_markers find_package calls, plus
#   the matching <depend> entries in package.xml. The Pi is headless and has no
#   Qt5 or rviz2 installed, so stock slam_toolbox will not configure. Re-apply
#   after any upstream bump.
#
# Packages listed in .gitignore but not present in src/ (never cloned on this
# machine, so nothing to pin): behaviortree_ros2, ros2_laser_scan_matcher,
# robot_localization, ros2_control, ros2_controllers.
